                                        </div>
                                    </div>

                                    {/* กล่อง T */}
                                    <div style={{ background: '#f8fafc', border: '1px solid #e2e8f0', borderRadius: '5px', padding: '4px 6px' }}>
                                        <span style={{ fontSize: '9px', fontWeight: 800, color: '#1e40af', display: 'block', marginBottom: '2px' }}>
                                            ความหนา T (mm.) <span style={{ color: '#ef4444' }}>*</span>
                                        </span>
                                        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr) 1.2fr', gap: '2px', alignItems: 'center' }}>
                                            <div>
                                                <label style={{ display: 'block', textAlign: 'center', fontSize: '8px', color: '#64748b', marginBottom: '1px' }}>T1</label>
