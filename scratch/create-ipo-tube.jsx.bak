                                                    <input
                                                        ref={id2_1_Ref}
                                                        type="text"
                                                        inputMode="decimal"
                                                        className="form-field-input"
                                                        style={{
                                                            textAlign: 'center', padding: '1px', height: '25px', fontSize: '11.5px', fontWeight: 700,
                                                            borderColor: formErrors.id2_1 ? '#ef4444' : '#cbd5e1',
                                                            background: formErrors.id2_1 ? '#fef2f2' : '#ffffff'
                                                        }}
                                                        value={id2_1}
                                                        onChange={(e) => {
                                                            setId2_1(e.target.value);
                                                            if (formErrors.id2_1) setFormErrors(prev => ({ ...prev, id2_1: undefined }));
                                                        }}
                                                        onKeyDown={(e) => {
