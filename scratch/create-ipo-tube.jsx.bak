                                                    <input
                                                        ref={t2_1_Ref}
                                                        type="text"
                                                        inputMode="decimal"
                                                        className="form-field-input"
                                                        style={{
                                                            textAlign: 'center', padding: '1px', height: '25px', fontSize: '11px', fontWeight: 700,
                                                            borderColor: formErrors.t2_1 ? '#ef4444' : '#cbd5e1',
                                                            background: formErrors.t2_1 ? '#fef2f2' : '#ffffff'
                                                        }}
                                                        value={t2_1}
                                                        onChange={(e) => {
                                                            setT2_1(e.target.value);
                                                            if (formErrors.t2_1) setFormErrors(prev => ({ ...prev, t2_1: undefined }));
                                                        }}
                                                        onKeyDown={(e) => {
