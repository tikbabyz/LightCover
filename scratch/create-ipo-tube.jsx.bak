                                                            textAlign: 'center', padding: '1px', height: '25px', fontSize: '11.5px', fontWeight: 700,
                                                            borderColor: formErrors.id1_1 ? '#ef4444' : '#cbd5e1',
                                                            background: formErrors.id1_1 ? '#fef2f2' : '#ffffff'
                                                        }}
                                                        value={id1_1}
                                                        onChange={(e) => {
