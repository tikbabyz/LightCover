                                                                e.preventDefault();
                                                                t4_1_Ref.current?.focus();
                                                                t4_1_Ref.current?.select?.();
                                                            }
                                                        }}
                                                        onFocus={(e) => e.target.select()}
                                                        placeholder=""
                                                    />
                                                </div>
