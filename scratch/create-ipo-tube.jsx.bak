                                                </span>
                                            )}
                                        </div>
                                    </div>

                                    {/* ตาราง Mini-Grid ขยายช่องไฟ ชัดเจน & ค่าเฉลี่ยเด่นชัด */}
                                    <div style={{ display: 'grid', gridTemplateColumns: 'minmax(120px, 1fr) minmax(180px, 1.35fr)', gap: '4px' }}>
                                        {/* กล่อง ID */}
                                        <div style={{ background: '#f8fafc', border: '1px solid #e2e8f0', borderRadius: '5px', padding: '4px 6px' }}>
                                            <span style={{ fontSize: '9px', fontWeight: 800, color: '#047857', display: 'block', marginBottom: '2px' }}>
                                                ขนาดรูใน ID (mm.) <span style={{ color: '#ef4444' }}>*</span>
                                            </span>
