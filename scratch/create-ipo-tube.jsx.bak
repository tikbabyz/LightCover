                                {/* กล่องตรวจวัด ท่อที่ 2 */}
                                <div style={{
                                    background: '#ffffff',
                                    border: '1.5px solid #cbd5e1',
                                    borderRadius: '7px',
                                    padding: '5px 8px',
                                    display: 'flex',
                                    flexDirection: 'column',
                                    gap: '4px'
                                }}>
                                    {/* หัวข้อท่อ 2 & Selector & Judge */}
                                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '4px' }}>
                                        <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                                            <span style={{
                                                fontSize: '11.5px',
                                                fontWeight: 800,
                                                color: '#15803d',
                                                display: 'inline-flex',
                                                alignItems: 'center',
                                                gap: '4px'
                                            }}>
                                                <span style={{ width: '7px', height: '7px', borderRadius: '50%', background: '#16a34a' }}></span>
                                                TUBE 2
                                            </span>
                                            <div style={{ display: 'flex', alignItems: 'center', gap: '3px' }}>
                                                <span style={{ fontSize: '10px', fontWeight: 700, color: '#475569' }}>สเปก:</span>
                                                <select
                                                    value={tube2Spec}
                                                    onChange={(e) => handleSpecChange(1, e.target.value)}
                                                    style={{
                                                        height: '24px',
                                                        padding: '1px 5px',
                                                        borderRadius: '4px',
                                                        border: '1.5px solid #bbf7d0',
                                                        background: '#f0fdf4',
                                                        color: '#15803d',
                                                        fontSize: '11px',
                                                        fontWeight: 800,
                                                        cursor: 'pointer'
                                                    }}
                                                    title="คลิกเพื่อเลือกหรือพิมพ์ระบุสเปกท่อ TAP 2"
                                                >
                                                    <option value="2">TAP 2</option>
                                                    <option value="3">TAP 3</option>
                                                    <option value="4">TAP 4</option>
                                                    <option value="5">TAP 5</option>
                                                    <option value="6">TAP 6</option>
                                                    <option value="7">TAP 7</option>
                                                    {!['2', '3', '4', '5', '6', '7'].includes(String(tube2Spec)) && tube2Spec && (
                                                        <option value={tube2Spec}>TAP {tube2Spec}</option>
                                                    )}
                                                    <option value="CUSTOM">+ กำหนดเบอร์เอง...</option>
                                                </select>
                                                <button
                                                    type="button"
                                                    onClick={handleCopyLotFromTube1}
                                                    title="คัดลอก Lot TAP และ Emboss จากท่อ 1 มายังท่อ 2"
                                                    style={{
                                                        display: 'inline-flex',
                                                        alignItems: 'center',
                                                        gap: '3px',
                                                        padding: '2px 7px',
                                                        borderRadius: '4px',
                                                        fontSize: '9.5px',
                                                        fontWeight: 700,
                                                        background: '#ecfdf5',
                                                        border: '1px solid #6ee7b7',
                                                        color: '#047857',
                                                        cursor: 'pointer',
                                                        marginLeft: '4px'
                                                    }}
                                                >
                                                    <Copy size={11} />
                                                    <span>เหมือนท่อ 1</span>
                                                </button>
                                            </div>
                                        </div>

                                        {/* Judge OK / NG */}
                                        <div style={{ display: 'flex', alignItems: 'center', gap: '3px' }}>
                                            <span style={{ fontSize: '9.5px', fontWeight: 700, color: '#64748b' }}>Judge:</span>
                                            <button
                                                type="button"
                                                onClick={() => setJudgement2('OK')}
                                                style={{
                                                    padding: '2px 8px',
                                                    borderRadius: '4px',
                                                    fontSize: '10.5px',
                                                    fontWeight: 800,
                                                    border: judgement2 === 'OK' ? '1.5px solid #16a34a' : '1px solid #cbd5e1',
                                                    cursor: 'pointer',
                                                    background: judgement2 === 'OK' ? '#16a34a' : '#ffffff',
                                                    color: judgement2 === 'OK' ? '#ffffff' : '#64748b',
                                                    boxShadow: judgement2 === 'OK' ? '0 1px 2px rgba(22,163,74,0.2)' : 'none'
                                                }}
                                            >
                                                OK
                                            </button>
                                            <button
                                                type="button"
                                                onClick={() => setJudgement2('NG')}
                                                style={{
                                                    padding: '2px 8px',
                                                    borderRadius: '4px',
                                                    fontSize: '10.5px',
                                                    fontWeight: 800,
                                                    border: judgement2 === 'NG' ? '1.5px solid #dc2626' : '1px solid #cbd5e1',
                                                    cursor: 'pointer',
                                                    background: judgement2 === 'NG' ? '#dc2626' : '#ffffff',
                                                    color: judgement2 === 'NG' ? '#ffffff' : '#64748b',
                                                    boxShadow: judgement2 === 'NG' ? '0 1px 2px rgba(220,38,38,0.2)' : 'none'
                                                }}
                                            >
