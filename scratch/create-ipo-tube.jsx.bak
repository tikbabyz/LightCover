                                                    <input
                                                        ref={t3_1_Ref}
                                                        type="text"
                                                        inputMode="decimal"
                                                        className="form-field-input"
                                                        style={{
                                                            textAlign: 'center', padding: '1px', height: '25px', fontSize: '11px', fontWeight: 700,
                                                            borderColor: formErrors.t3_1 ? '#ef4444' : '#cbd5e1',
                                                            background: formErrors.t3_1 ? '#fef2f2' : '#ffffff'
                                                        }}
                                                        value={t3_1}
                                                        onChange={(e) => {
                                                            setT3_1(e.target.value);
                                                            if (formErrors.t3_1) setFormErrors(prev => ({ ...prev, t3_1: undefined }));
                                                        }}
                                                        onKeyDown={(e) => {
