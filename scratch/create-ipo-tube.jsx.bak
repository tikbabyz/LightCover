                                            </button>
                                        </div>
                                    </div>

                                    {/* Lot No. TAP 2 & Lot No. Emboss 2 */}
                                    <div style={{
                                        background: (formErrors.lotNoTap2 || formErrors.lotNoEmboss2) ? '#fef2f2' : '#f0fdf4',
