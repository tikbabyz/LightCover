                                                        borderColor: formErrors.lotNoEmboss ? '#ef4444' : '#cbd5e1'
                                                    }}
                                                />
                                                <Scan size={11} color="#94a3b8" style={{ position: 'absolute', right: '5px', top: '6px', pointerEvents: 'none' }} />
                                            </div>
                                            {formErrors.lotNoEmboss && (
                                                <span style={{ color: '#dc2626', fontSize: '8.5px', fontWeight: 700, display: 'block' }}>
                                                    {formErrors.lotNoEmboss}
                                                </span>
                                            )}
                                        </div>
                                    </div>

                                    {/* ตาราง Mini-Grid ขยายช่องไฟ ชัดเจน & ค่าเฉลี่ยเด่นชัด */}
                                    <div style={{ display: 'grid', gridTemplateColumns: 'minmax(120px, 1fr) minmax(180px, 1.35fr)', gap: '4px' }}>
                                        {/* กล่อง ID */}
                                        <div style={{ background: '#f8fafc', border: '1px solid #e2e8f0', borderRadius: '5px', padding: '4px 6px' }}>
                                            <span style={{ fontSize: '9px', fontWeight: 800, color: '#1e40af', display: 'block', marginBottom: '2px' }}>
                                                ขนาดรูใน ID (mm.) <span style={{ color: '#ef4444' }}>*</span>
                                            </span>
                                            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1.15fr', gap: '3px', alignItems: 'center' }}>
