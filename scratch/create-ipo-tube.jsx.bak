                                        {/* Lot No. Emboss 2 (สแกน / พิมพ์) */}
                                        <div>
                                            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '1px' }}>
                                                <span style={{ fontSize: '9.5px', fontWeight: 800, color: '#0f172a', display: 'flex', alignItems: 'center', gap: '3px' }}>
                                                    <Scan size={11} color="#475569" />
                                                    Lot No. Emboss 2 <span style={{ color: '#ef4444' }}>*</span>
                                                </span>
                                                <span style={{ fontSize: '8px', color: '#64748b' }}>สแกน Barcode</span>
                                            </div>
                                            <div style={{ position: 'relative' }}>
