                                                                e.preventDefault();
                                                                t1_1_Ref.current?.focus();
                                                                t1_1_Ref.current?.select?.();
                                                            }
                                                        }}
                                                        onFocus={(e) => e.target.select()}
                                                        placeholder=""
                                                    />
                                                </div>
                                                <div>
