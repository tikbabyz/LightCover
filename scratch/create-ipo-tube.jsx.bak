                                                                e.preventDefault();
                                                                t3_1_Ref.current?.focus();
                                                                t3_1_Ref.current?.select?.();
                                                            }
                                                        }}
                                                        onFocus={(e) => e.target.select()}
                                                        placeholder=""
                                                    />
                                                </div>
                                                <div>
