                                                    <label style={{ display: 'block', textAlign: 'center', fontSize: '8px', color: '#64748b', marginBottom: '1px' }}>ID1</label>
                                                    <input
                                                        ref={id1_1_Ref}
                                                        type="text"
                                                        inputMode="decimal"
                                                        className="form-field-input"
