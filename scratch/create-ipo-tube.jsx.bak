                                                    <div style={{
                                                        height: '25px', background: '#eff6ff', border: '1.5px solid #60a5fa',
                                                        borderRadius: '4px', display: 'flex', alignItems: 'center',
                                                        justifyContent: 'center', fontWeight: 900, fontSize: '11.5px', color: '#1e40af',
                                                        boxShadow: '0 1px 2px rgba(59, 130, 246, 0.1)'
                                                    }}>
                                                        {idAvg1 || '-'}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        {/* กล่อง T */}
                                        <div style={{ background: '#f8fafc', border: '1px solid #e2e8f0', borderRadius: '5px', padding: '4px 6px' }}>
                                            <span style={{ fontSize: '9px', fontWeight: 800, color: '#1e40af', display: 'block', marginBottom: '2px' }}>
                                                ความหนา T (mm.) <span style={{ color: '#ef4444' }}>*</span>
                                            </span>
                                            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr) 1.2fr', gap: '2px', alignItems: 'center' }}>
                                                <div>
                                                    <label style={{ display: 'block', textAlign: 'center', fontSize: '8px', color: '#64748b', marginBottom: '1px' }}>T1</label>
                                                    <input
                                                        ref={t1_1_Ref}
                                                        type="text"
                                                        inputMode="decimal"
                                                        className="form-field-input"
                                                        style={{
                                                            textAlign: 'center', padding: '1px', height: '25px', fontSize: '11px', fontWeight: 700,
                                                            borderColor: formErrors.t1_1 ? '#ef4444' : '#cbd5e1',
                                                            background: formErrors.t1_1 ? '#fef2f2' : '#ffffff'
                                                        }}
                                                        value={t1_1}
                                                        onChange={(e) => {
