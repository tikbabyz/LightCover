                                            </select>
                                        </div>
                                    </div>

                                    {/* Judge OK / NG */}
                                    <div style={{ display: 'flex', alignItems: 'center', gap: '3px' }}>
                                        <span style={{ fontSize: '9.5px', fontWeight: 700, color: '#64748b' }}>Judge:</span>
                                        <button
                                            type="button"
                                            onClick={() => setJudgement1('OK')}
                                            style={{
                                                padding: '2px 8px',
                                                borderRadius: '4px',
                                                fontSize: '10.5px',
                                                fontWeight: 800,
                                                border: judgement1 === 'OK' ? '1.5px solid #16a34a' : '1px solid #cbd5e1',
                                                cursor: 'pointer',
                                                background: judgement1 === 'OK' ? '#16a34a' : '#ffffff',
                                                color: judgement1 === 'OK' ? '#ffffff' : '#64748b',
                                                boxShadow: judgement1 === 'OK' ? '0 1px 2px rgba(22,163,74,0.2)' : 'none'
                                            }}
                                        >
                                            OK
                                        </button>
                                        <button
                                            type="button"
                                            onClick={() => setJudgement1('NG')}
                                            style={{
                                                padding: '2px 8px',
                                                borderRadius: '4px',
                                                fontSize: '10.5px',
                                                fontWeight: 800,
                                                border: judgement1 === 'NG' ? '1.5px solid #dc2626' : '1px solid #cbd5e1',
                                                cursor: 'pointer',
                                                background: judgement1 === 'NG' ? '#dc2626' : '#ffffff',
                                                color: judgement1 === 'NG' ? '#ffffff' : '#64748b',
