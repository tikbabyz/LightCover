                                                    <input
                                                        ref={t4_1_Ref}
                                                        type="text"
                                                        inputMode="decimal"
                                                        className="form-field-input"
                                                        style={{
                                                            textAlign: 'center', padding: '1px', height: '25px', fontSize: '11px', fontWeight: 700,
                                                            borderColor: formErrors.t4_1 ? '#ef4444' : '#cbd5e1',
                                                            background: formErrors.t4_1 ? '#fef2f2' : '#ffffff'
                                                        }}
                                                        value={t4_1}
                                                        onChange={(e) => {
                                                            setT4_1(e.target.value);
                                                            if (formErrors.t4_1) setFormErrors(prev => ({ ...prev, t4_1: undefined }));
                                                        }}
                                                        onKeyDown={(e) => {
                                                            if (e.key === 'Enter') {
                                                                e.preventDefault();
                                                                lotTapInputRef2.current?.focus();
                                                                lotTapInputRef2.current?.select?.();
                                                            }
                                                        }}
                                                        onFocus={(e) => e.target.select()}
                                                        placeholder=""
                                                    />
                                                </div>
                                                <div>
                                                    <label style={{ display: 'block', textAlign: 'center', fontSize: '8.5px', fontWeight: 800, color: '#1d4ed8', marginBottom: '1px' }}>AVG</label>
                                                    <div style={{
                                                        height: '25px', background: '#eff6ff', border: '1.5px solid #60a5fa',
                                                        borderRadius: '4px', display: 'flex', alignItems: 'center',
                                                        justifyContent: 'center', fontWeight: 900, fontSize: '11.5px', color: '#1e40af',
                                                        boxShadow: '0 1px 2px rgba(59, 130, 246, 0.1)'
                                                    }}>
                                                        {tAvg1 || '-'}
