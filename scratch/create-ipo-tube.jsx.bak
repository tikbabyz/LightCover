                                                    fontSize: '11px',
                                                    fontWeight: 700,
                                                    padding: '1px 4px',
                                                    background: formErrors.lotNoTap ? '#fff5f5' : '#ffffff',
                                                    borderColor: formErrors.lotNoTap ? '#ef4444' : '#cbd5e1',
                                                    color: lotNoTap ? '#0f172a' : '#64748b'
                                                }}
                                            />
                                            {formErrors.lotNoTap && (
                                                <span style={{ color: '#dc2626', fontSize: '8.5px', fontWeight: 700, display: 'block' }}>
                                                    {formErrors.lotNoTap}
                                                </span>
                                            )}
                                        </div>

                                        {/* Lot No. Emboss 1 (สแกน / พิมพ์) */}
                                        <div>
                                            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '1px' }}>
                                                <span style={{ fontSize: '9.5px', fontWeight: 800, color: '#0f172a', display: 'flex', alignItems: 'center', gap: '3px' }}>
                                                    <Scan size={11} color="#475569" />
                                                    Lot No. Emboss 1 <span style={{ color: '#ef4444' }}>*</span>
                                                </span>
                                                <span style={{ fontSize: '8px', color: '#64748b' }}>สแกน Barcode</span>
                                            </div>
                                            <div style={{ position: 'relative' }}>
                                                <input
                                                    ref={lotEmbossInputRef}
                                                    type="text"
                                                    className="form-field-input"
                                                    placeholder="สแกนหรือพิมพ์ Lot Emboss 1..."
                                                    value={lotNoEmboss}
                                                    onChange={(e) => {
                                                        setLotNoEmboss(e.target.value);
                                                        if (formErrors.lotNoEmboss) setFormErrors(prev => ({ ...prev, lotNoEmboss: undefined }));
                                                    }}
                                                    onKeyDown={(e) => {
                                                        if (e.key === 'Enter') {
                                                            e.preventDefault();
                                                            id1_1_Ref.current?.focus();
                                                            id1_1_Ref.current?.select?.();
                                                        }
