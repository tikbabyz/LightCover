  "components": {
    "schemas": {
      "ActivityLog": {
        "required": [
          "actionType",
          "employeeName",
          "job",
          "module",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "module": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "job": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "actionType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "employeeId": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "employeeName": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "runNo": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "details": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "BomResponse": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "nullable": true
          },
          "operateNumber": {
            "type": "integer",
            "format": "int32"
          },
          "materialItem": {
            "type": "string",
            "nullable": true
          },
          "materialDescription": {
            "type": "string",
            "nullable": true
          },
          "materialColor": {
            "type": "string",
            "nullable": true
          },
          "materialPVCColor": {
            "type": "string",
            "nullable": true
          },
